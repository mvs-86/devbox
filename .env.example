# Copy to .env and fill in. Never commit .env.

# --- Image ---
R_VERSION=4.5.3
IMAGE_FLAVOR=verse
IMAGE_SUFFIX=-devtools-docker

# --- User / container ---
NB_UID=1000
NB_GID=100
# Set to "yes" once if files in the home volume have the wrong owner
CHOWN_HOME=no
# "yes" gives jovyan passwordless sudo (needed to run blas-switch interactively)
GRANT_SUDO=no
TZ=America/Sao_Paulo
LOCAL_PORT=8888
# GID owning /var/run/docker.sock on the host (`stat -c %g /var/run/docker.sock`);
# 0 works for Docker Desktop
DOCKER_GID=0

# --- API keys ---
ALPHAVANTAGE_API_KEY=
# Optional; otherwise run `claude` in a terminal and log in
ANTHROPIC_API_KEY=

# --- BLAS ---
# Empty = image default (openblas-pthread). Options: openblas-pthread,
# openblas-openmp, openblas-serial, blis-pthread, blis-openmp, reference
BLAS_IMPL=
OPENBLAS_NUM_THREADS=4
OMP_NUM_THREADS=4

# --- DockFlare / Cloudflare ---
JUPYTER_HOSTNAME=jupyter.example.com
CODE_HOSTNAME=code.example.com
RSTUDIO_HOSTNAME=rstudio.example.com
# Comma-separated emails and/or @domains allowed through Cloudflare Access
ACCESS_EMAILS=you@example.com
ACCESS_SESSION_DURATION=24h
